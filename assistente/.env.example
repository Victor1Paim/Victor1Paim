# --- WhatsApp Cloud API (Meta for Developers) ---
WHATSAPP_TOKEN=coloque-o-token-de-acesso
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_VERIFY_TOKEN=uma-frase-secreta-qualquer
WHATSAPP_APP_SECRET=chave-secreta-do-app
WHATSAPP_API_VERSION=v23.0
# Só estes números falam com o bot (DDI+DDD+número, sem +). Separe por vírgula.
NUMEROS_PERMITIDOS=5511999999999

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODELO=gpt-5.4-mini
OPENAI_MODELO_TRANSCRICAO=gpt-4o-mini-transcribe

# --- Google (Agenda + Gmail) ---
# Gerado por scripts/autorizar_google.py. Em servidor, pode colar o JSON inteiro em GOOGLE_TOKEN_JSON.
GOOGLE_TOKEN_ARQUIVO=token.json
GOOGLE_TOKEN_JSON=
GOOGLE_AGENDA_ID=primary

# --- Geral ---
FUSO_HORARIO=America/Sao_Paulo
NOME_DONO=Victor
PASTA_DADOS=dados
MEMORIA_MENSAGENS=20
